# Application ID from the Enable Banking control panel (API Applications)
EB_APP_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee

# Private key (.pem) you downloaded when registering the application
EB_PRIVATE_KEY_PATH=secrets/enablebanking.pem

# Must exactly match an "Allowed redirect URL" registered on the application
EB_REDIRECT_URL=https://localhost:3443/callback

# Country for bank lookups
EB_COUNTRY=BE

# Your data (database and categories.json) lives in one folder of the app's own:
#   macOS ~/Library/Application Support/Munto, Windows %APPDATA%\Munto, Linux ~/.local/share/munto
# To use another folder: MUNTO_DATA_DIR=/path/to/folder

# Optional: "Suggest with AI" (npm run ui, npm run review -- --ai) runs the Claude Code CLI on your
# Claude subscription; install it and run `claude` once to log in. No API key needed.
# SUGGEST_MODEL=sonnet
